{
  "name": "blog-workspace",
  "private": true,
  "description": "huanwu's blog",
  "scripts": {
    "dev": "pnpm --filter @huanwu/blog dev",
    "build": "pnpm --filter @huanwu/blog build",
    "preview": "pnpm --filter @huanwu/blog preview",
    "lint": "oxlint --deny-warnings packages",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm format:check",
    "verify:migration": "pnpm --filter @huanwu/blog verify:migration"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.3",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=12.23.0"
  },
  "packageManager": "pnpm@12.23.0"
}
