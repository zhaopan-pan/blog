---
import { themeCopy } from '../theme-copy.js'
---

<button
  class="back-to-top"
  type="button"
  aria-label={themeCopy.post.top}
  title={themeCopy.post.top}
  hidden
>
  <svg
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 19V5m-6 6 6-6 6 6" />
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.back-to-top')!
  const heading = document.querySelector<HTMLHeadingElement>('.post-head h1')!
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')

  // Keep the control out of the way until the heading is well above the viewport.
  new IntersectionObserver(
    ([entry]) => {
      button.hidden = entry.isIntersecting || entry.boundingClientRect.bottom >= 0
    },
    { rootMargin: '400px 0px 0px' },
  ).observe(heading)

  button.addEventListener('click', () => {
    if (location.hash) history.replaceState(history.state, '', location.pathname + location.search)
    heading.focus({ preventScroll: true })
    window.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'instant' : 'smooth' })
  })
</script>

<style>
  .back-to-top:not([hidden]) {
    position: fixed;
    z-index: 5;
    inset-inline-end: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 0;
    border-radius: 50%;
  }
  .back-to-top:is(:hover, :focus-visible) {
    color: var(--glass-accent);
  }
  @media print {
    .back-to-top:not([hidden]) {
      display: none;
    }
  }
</style>
